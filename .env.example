# --- Telegram ---
# 1. @BotFather -> /newbot -> copy token
# 2. /start the bot -> it echoes your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MetaTrader 5 ---
# Only needed if the terminal is NOT running and MT5 cannot auto-find it.
# Example: MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# --- Monitoring ---
MONITOR_ENABLED=true
REPORT_INTERVAL_MINUTES=30
MONITOR_TIMEFRAME=M15

# --- Signal events (factual indicator events, NOT trade recommendations) ---
SIGNALS_ENABLED=true
SIGNAL_COOLDOWN_MINUTES=60

# --- Local LLM (optional; core bot fully works without it) ---
AI_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_KEEP_ALIVE=15m

# --- Logging / storage ---
LOG_LEVEL=INFO
DB_PATH=bot_data.sqlite3